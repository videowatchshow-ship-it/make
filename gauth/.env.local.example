# gauth 로컬 서버 환경변수 — 복사해서 .env.local 로 저장
# cp .env.local.example .env.local

# API 접근 비번 (브라우저에서 입력하는 토큰)
GAUTH_API_TOKEN=your-secret-token

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
# OAuth 2.0 클라이언트 ID (데스크톱 앱 또는 웹 앱 유형)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# 서버 포트 (기본 4000)
PORT=4000
