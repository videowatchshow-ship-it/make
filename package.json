{
  "name": "google-login-bot",
  "version": "1.0.0",
  "description": "YouTube 계정 자동 로그인 및 뷰봇 관리 시스템",
  "main": "real-browser-login.js",
  "type": "commonjs",
  "scripts": {
    "start": "node real-browser-login.js",
    "dev": "node real-browser-login.js",
    "server": "node server.js",
    "test": "node test-browser-simple.js",
    "check-env": "node env-validator.js",
    "check-paths": "node path-validator.js",
    "security-check": "node security-check.js",
    "validate": "npm run check-env && npm run check-paths && npm run security-check",
    "diagnose": "node diagnostics.js",
    "logs": "tail -f logs/*.log"
  },
  "keywords": [
    "puppeteer",
    "google-login",
    "youtube",
    "automation"
  ],
  "author": "Team",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "otplib": "^12.0.1",
    "puppeteer-real-browser": "^1.0.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "puppeteer": "^19.0.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
